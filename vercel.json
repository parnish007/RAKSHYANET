{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.py" }
  ],
  "env": {
    "SATELLITE_TOOL_ENABLED": "false",
    "GEMMA_ORCHESTRATION_TIMEOUT_SECONDS": "50",
    "GEMMA_TIMEOUT_SECONDS": "35"
  }
}
