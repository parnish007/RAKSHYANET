# Production transport, baked into the bundle at build time.
#
# Vite substitutes import.meta.env.* during `vite build`, so these cannot be
# changed after the fact by editing a hosting dashboard -- a variable added
# there only takes effect on the NEXT build. Committing them here means a push
# is enough to produce a correctly wired bundle.
#
# The host matches the `name: rakshyanet-api` service in render.yaml. If Render
# assigns a different hostname (it appends a suffix when the name is taken),
# change both lines below and push again.
#
# No secrets belong in this file. Vite exposes every VITE_-prefixed variable to
# the browser, so anything written here is public. API keys stay on the backend.
VITE_API_URL=https://rakshyanet-api.onrender.com
VITE_WS_URL=wss://rakshyanet-api.onrender.com/ws
