# RakshyaNet Environment Variables
# Copy this file to .env and fill in your values

# Gemma is not active yet. Future providers must remain optional.
GEMMA_PROVIDER=gemini_api
GEMMA_API_KEY=
# Optional additional keys. The service rotates across the whole pool and fails
# over to the next key on a 429, so a rate limit does not surface as an error.
# Numbered variables (GEMMA_API_KEY_2, _3, ...) or a comma-separated list in any
# one variable both work.
GEMMA_API_KEY_2=
GEMMA_API_KEY_3=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TIMEOUT_SECONDS=45
# Function-calling turns emit reasoning and make several round trips, so they
# need a much larger budget than a single extraction call.
GEMMA_ORCHESTRATION_TIMEOUT_SECONDS=90

# Frontend transport
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Backend Config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Optimization Config
URGENCY_DELTA_THRESHOLD=0.10
ALLOCATION_TIME_LIMIT_SECONDS=15
KKT_TOLERANCE=1e-6

# P2P Mesh Config
P2P_PORT=5555
P2P_BROADCAST_PORT=5556
P2P_DISCOVERY_TIMEOUT=5

# HITL Config
HITL_TIMEOUT_SECONDS=300

# Demo Mode (uses mock data, no real API calls)
DEMO_MODE=true
DEMO_NEWS_INTERVAL_SECONDS=30
